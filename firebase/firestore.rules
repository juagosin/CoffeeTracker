rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Backup por usuario (auth anónima): solo el propio uid
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Estadísticas globales agregadas: solo incrementos desde clientes autenticados
    match /global_stats/totals {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /global_stats/coffee_types/types/{typeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /global_stats/achievements/items/{achievementId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
